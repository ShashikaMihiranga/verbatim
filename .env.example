# Copy to .env for local use. Placeholders only; never commit real values.
ENV=dev
DATABASE_URL=sqlite:///./dev.db
CLERK_JWKS_URL=
CLERK_ISSUER=
# Clerk (public values only; never put the Clerk secret key here)
CLERK_FRONTEND_API=
CLERK_AUTHORIZED_PARTIES=
# Optional: SIGNIN_VARIANT_WEIGHTS=a=1,b=1,c=1,d=1
# Frontend build variable (set in Railway or frontend/.env.local): VITE_CLERK_PUBLISHABLE_KEY=
# ALLOW_DEV_USER=true   # local only, requires ENV=dev, NEVER set in production

# Theme editor grouping: "claude" turns on "Find matches" (one Claude call per theme list, cached).
# VERBATIM_THEME_GROUPING=claude
# Cheap model for column hints, report headlines and grouping; defaults to claude-haiku-5-5.
# Theme naming keeps VERBATIM_CLAUDE_MODEL (default claude-sonnet-5).
# VERBATIM_CLAUDE_LIGHT_MODEL=
